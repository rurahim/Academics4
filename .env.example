# ===========================================
# Academics4 Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Required variables are marked with (REQUIRED)

# ===========================================
# DATABASE (REQUIRED)
# ===========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academics4"

# For Docker deployment:
# DATABASE_URL="postgresql://postgres:your-password@db:5432/academics4"

# ===========================================
# AUTHENTICATION (REQUIRED)
# ===========================================
# JWT secrets - MUST be unique and secure in production!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# ===========================================
# APPLICATION (REQUIRED)
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# DOCKER PRODUCTION (for docker-compose.prod.yml)
# ===========================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-password"
POSTGRES_DB="academics4"
APP_PORT="3000"

# ===========================================
# EMAIL (OPTIONAL)
# ===========================================
# SENDGRID_API_KEY="your-sendgrid-api-key"
# EMAIL_FROM="noreply@academics4.org"

# ===========================================
# AI/LLM (OPTIONAL - for semantic matching)
# ===========================================
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
